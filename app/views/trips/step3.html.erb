<% back_url = params[:from_confirm] == "true" ? confirm_trips_path : step2_trips_path %>
<% content_for :back_path, back_url %>

<!-- 画面全体を中央寄せにするラッパー -->
<div class="min-h-screen w-full flex flex-col items-center bg-[#FAF6F0]">

  <!-- スマホ幅コンテナ（Stimulusコントローラを接続） -->
  <div class="w-full max-w-[430px] min-h-screen mx-auto px-5 flex flex-col bg-[#FAF6F0]"
       data-controller="geolocation">

    <!-- 共通ヘッダー（STEP2へ戻る / 確認画面から来た場合は確認画面へ戻る） -->
    <%= render "shared/header", back_path: back_url %>

    <!-- ステータスバー ＋ キャラクター＆吹き出しエリア（背景画像が切れない構造） -->
    <div class="relative -mx-5 overflow-hidden">
      <%= image_tag "shirube_step3.png",
            alt: "出発地を尋ねるしるべぇ駅長",
            width: 1477,
            height: 1065,
            fetchpriority: "high",
            class: "w-full h-auto block select-none pointer-events-none" %>

      <!-- 下端の境界を画面背景色(#FAF6F0)に自然に馴染ませるグラデーション -->
      <div class="absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-[#FAF6F0] via-[#FAF6F0]/75 to-transparent z-10 pointer-events-none"></div>

      <!-- 画像の上に重ねる要素（ステータスバー ＋ 右寄せの吹き出し） -->
      <div class="absolute inset-0 z-20 flex flex-col justify-between pt-3 pb-4 px-5">

        <!-- 1. ステータスバー（上部に配置） -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="bg-[#F3E2C7]/95 backdrop-blur-sm text-[#8A5A2B] text-[13px] font-extrabold px-3.5 py-1 rounded-full shadow-sm">
              STEP 3 / 5
            </span>
            <span class="bg-white/95 backdrop-blur-sm text-[#3D2B1F] text-[13px] font-bold px-3.5 py-1 rounded-full shadow-sm">
              出発地の選択
            </span>
          </div>

          <!-- 5分割プログレスバー（3つ目までオレンジ） -->
          <div class="grid grid-cols-5 gap-2">
            <div class="h-2 rounded-full bg-[#E07A2E] shadow-xs"></div>
            <div class="h-2 rounded-full bg-[#E07A2E] shadow-xs"></div>
            <div class="h-2 rounded-full bg-[#E07A2E] shadow-xs"></div>
            <div class="h-2 rounded-full bg-[#E6D5B8]/85 backdrop-blur-xs"></div>
            <div class="h-2 rounded-full bg-[#E6D5B8]/85 backdrop-blur-xs"></div>
          </div>
        </div>

        <!-- 2. 吹き出し（justify-end で右側に配置） -->
        <div class="flex justify-end items-center pr-1 mb-24">
          <div class="relative w-[48%] flex items-center justify-center">
            <%= image_tag "comment.png",
                  alt: "吹き出し",
                  width: 1536,
                  height: 1024,
                  class: "w-full h-auto object-contain select-none pointer-events-none drop-shadow-sm" %>
            <p class="absolute inset-0 flex items-center justify-center pb-2 px-4 text-[15px] font-extrabold text-[#3D2B1F] leading-relaxed tracking-wide text-center">
              どこから<br>出発する？
            </p>
          </div>
        </div>

      </div>
    </div>

    <%# --- 3. 出発地の選択エリア（フラッシュメッセージ ＋ 現在地取得 ＋ 手入力 ＋ 全国主要駅チップ） --- %>
    <div class="relative -mt-6 z-20 space-y-4">

      <%# フラッシュメッセージ %>
      <% if flash[:alert].present? %>
        <div class="py-2.5 px-4 rounded-xl bg-red-50/95 border border-red-200 text-red-700 text-xs font-bold text-center shadow-xs">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%# ① 現在地から最寄駅を探すボタン %>
      <div>
        <button type="button"
                data-geolocation-target="button"
                data-action="click->geolocation#findNearestStations"
                class="w-full py-3.5 px-4 rounded-full bg-white hover:bg-[#FFF9EE] active:bg-[#F7E6D5] active:scale-95 active:translate-y-1 active:shadow-none select-none border-2 border-[#E6D5B8] hover:border-[#E07A2E] text-[#3D2B1F] font-extrabold text-[15px] flex items-center justify-center gap-2 shadow-sm transition-all duration-100 disabled:opacity-50">
          <span class="text-lg leading-none">📍</span>
          <span>いまいる場所から探す</span>
        </button>

        <%# 取得中・結果メッセージ表示枠 %>
        <p data-geolocation-target="status" class="hidden text-xs font-bold text-center mt-2.5"></p>

        <%# 取得された最寄駅候補ボタンがここに展開される %>
        <div data-geolocation-target="results" class="mt-2.5 space-y-2"></div>
      </div>

      <%# 区切り線「または入力」 %>
      <div class="flex items-center gap-3 px-2">
        <div class="flex-1 h-px bg-[#E0D2BE]"></div>
        <span class="text-xs font-bold text-[#8A7360]">または入力</span>
        <div class="flex-1 h-px bg-[#E0D2BE]"></div>
      </div>

      <%# ② 手入力フォーム ＋ 全国主要駅チップ ＋ つぎへボタン %>
      <%= form_with url: save_step3_trips_path, method: :post, local: true, class: "space-y-4" do %>
        <% if params[:from_confirm] == "true" %>
          <%= hidden_field_tag :from_confirm, "true" %>
        <% end %>

        <%# テキスト入力欄 %>
        <div>
          <%= text_field_tag :departure,
                @departure,
                id: "departure_input",
                placeholder: "例：東京駅・大阪駅",
                autocomplete: "off",
                data: {
                  geolocation_target: "input",
                  action: "focus->geolocation#scrollOnFocus"
                },
                class: "w-full rounded-2xl border-2 border-[#E6D5B8] bg-white px-4 py-3.5 text-base font-bold text-[#3D2B1F] placeholder-[#B8A693] focus:border-[#E07A2E] focus:outline-none shadow-xs" %>
        </div>

        <%# 全国主要駅のクイック選択チップ（8駅） %>
        <% major_stations = %w[東京駅 新宿駅 横浜駅 名古屋駅 大阪駅 京都駅 博多駅 札幌駅] %>
        <div class="flex flex-wrap justify-start gap-2">
          <% major_stations.each do |station| %>
            <button type="button"
                    data-action="click->geolocation#selectStation"
                    data-station-name="<%= station %>"
                    class="px-3.5 py-1.5 rounded-full bg-white hover:bg-[#FFF9EE] active:scale-95 border border-[#E6D5B8] hover:border-[#E07A2E] text-xs font-bold text-[#5C4433] shadow-2xs transition-all">
              <%= station %>
            </button>
          <% end %>
        </div>

        <%# 次へ進むボタン %>
        <button type="submit"
                class="w-full py-3.5 rounded-full bg-[#E07A2E] hover:bg-[#C8681E] active:scale-95 active:translate-y-1 active:shadow-none active:brightness-95 select-none text-white font-extrabold text-base shadow-md transition-all duration-100 flex items-center justify-center gap-2">
          <span>つぎへ</span>
          <span>🐾</span>
        </button>
      <% end %>
    </div>

    <!-- 4. 最下部エリア -->
    <div class="relative -mx-5 mt-auto pt-4 overflow-hidden">
      <%= image_tag "step_bg_bottom.png",
            alt: "",
            width: 853,
            height: 308,
            class: "w-full h-auto block select-none pointer-events-none" %>
      <div class="absolute inset-x-0 top-0 h-15 bg-gradient-to-b from-[#FAF6F0] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-5 z-20 text-center">
        <%= link_to "トップ画面に戻る", root_path,
              class: "text-[14px] font-bold text-[#5C4433] underline underline-offset-4 decoration-[#5C4433]/60 hover:opacity-75 transition-opacity" %>
      </div>
    </div>

  </div>
</div>