<!-- 画面全体を中央寄せにするラッパー -->
<div class="min-h-screen w-full flex flex-col items-center bg-[#FAF6F0]">

  <!-- スマホ幅コンテナ（旅の手帳風ドットパターン背景） -->
  <div class="relative w-full max-w-[430px] min-h-screen mx-auto px-5 pb-12 flex flex-col bg-[#FAF6F0] [background-image:radial-gradient(#E5D3B8_1.2px,transparent_1.2px)] [background-size:18px_18px] font-sans text-[#4A3A2A] overflow-x-hidden shadow-sm">

    <!-- 共通ヘッダー（共有URLから直接開く場合も考慮しトップへ戻る） -->
    <%= render "shared/header", back_path: root_path %>

    <!-- 1. しおりリボン＆タイトルエリア -->
    <header class="relative pt-5 pb-4 text-center">
      <!-- 左上のしおりリボン飾り -->
      <div class="pointer-events-none absolute -top-1 left-2 w-7 h-12 bg-gradient-to-b from-[#EEA065] to-[#E58A53] shadow-xs"
           style="clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);"></div>

      <!-- 旅のしおりバッジ -->
      <div class="inline-block bg-[#E58A53] text-white text-xs font-extrabold px-4 py-1 rounded-sm tracking-widest shadow-xs mb-2.5">
        旅のしおり 🐾
      </div>

      <!-- タイトル（明朝体で特別感） -->
      <h1 class="text-[22px] font-bold text-[#3D2B1F] leading-snug tracking-wide border-b-2 border-dashed border-[#E6C7AE] pb-2.5 mx-2"
          style="font-family: 'Kaisei Decol', serif;">
        <%= @trip.title %>
      </h1>

      <% if @trip.area.present? %>
        <p class="mt-2 text-xs font-extrabold text-[#9F4813]">
          📍 <%= @trip.area %>
        </p>
      <% end %>
    </header>

    <div class="space-y-5">
      <!-- 2. ヴィンテージ乗車券風カード（左右分割チケット） -->
      <div class="drop-shadow-[0_4px_12px_rgba(159,72,19,0.1)]">
        <!-- 外側：枠線レイヤー（1.5px） -->
        <div
          class="bg-[#E5B089] rounded-[20px] p-[1.5px]"
          style="
            -webkit-mask-image:
              radial-gradient(circle at calc(100% - 96px) 0, transparent 10px, black 10.5px),
              radial-gradient(circle at calc(100% - 96px) 100%, transparent 10px, black 10.5px);
            -webkit-mask-composite: destination-in;
            mask-image:
              radial-gradient(circle at calc(100% - 96px) 0, transparent 10px, black 10.5px),
              radial-gradient(circle at calc(100% - 96px) 100%, transparent 10px, black 10.5px);
            mask-composite: intersect;
          ">
          <!-- 内側：チケット本体レイヤー -->
          <section
            class="bg-[#FDECD8] rounded-[18.5px] overflow-hidden"
            style="
              -webkit-mask-image:
                radial-gradient(circle at calc(100% - 94.5px) -1.5px, transparent 11.5px, black 12px),
                radial-gradient(circle at calc(100% - 94.5px) calc(100% + 1.5px), transparent 11.5px, black 12px);
              -webkit-mask-composite: destination-in;
              mask-image:
                radial-gradient(circle at calc(100% - 94.5px) -1.5px, transparent 11.5px, black 12px),
                radial-gradient(circle at calc(100% - 94.5px) calc(100% + 1.5px), transparent 11.5px, black 12px);
              mask-composite: intersect;
            ">
            <div class="grid grid-cols-[1fr_auto_94.5px]">
              <!-- 左側：メイン情報 -->
              <div class="p-3.5 space-y-2.5">
                <div class="flex items-center justify-between text-[10px] font-extrabold text-[#B8642E] tracking-wider border-b border-dashed border-[#E5B089] pb-1.5">
                  <span>MICHISHIRUBE TICKET</span>
                </div>

                <div class="flex items-start gap-2.5">
                  <div class="shrink-0 flex flex-col items-center">
                    <%= image_tag "shirube.png", alt: "しるべ駅長", class: "w-[64px] h-auto object-contain" %>
                  </div>
                  <div class="space-y-2 min-w-0">
                    <% if @trip.description.present? %>
                      <p class="text-[11.5px] leading-relaxed text-[#5C4738]">
                        <%= @trip.description %>
                      </p>
                    <% end %>
                    <div class="flex flex-wrap gap-1 text-[10px] font-bold text-[#7A5236]">
                      <% if @trip.estimated_cost.present? %>
                        <span class="rounded-md border border-[#E5B089] bg-[#FFFDFB] px-1.5 py-0.5">
                          💰 約<%= number_with_delimiter(@trip.estimated_cost) %>円〜
                        </span>
                      <% end %>
                      <% if @trip.travel_time.present? %>
                        <span class="rounded-md border border-[#E5B089] bg-[#FFFDFB] px-1.5 py-0.5">
                          🚃 <%= @trip.travel_time %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 中央：縦の切り取り線 -->
              <div class="flex justify-center w-0 py-3">
                <div class="h-full border-l-[2px] border-dashed border-[#E5B089]"></div>
              </div>

              <!-- 右側：半券（出発地 → 目的地） -->
              <div class="p-2.5 bg-[#F9DEC2] flex flex-col items-center justify-center text-center space-y-1">
                <span class="text-[9px] font-extrabold tracking-widest text-[#B8642E]">ROUTE</span>
                <p class="text-[11px] font-extrabold text-[#3D2B1F] leading-tight break-words w-full">
                  <%= @trip.departure %>
                </p>
                <span class="text-xs font-bold text-[#E58A53]">↓</span>
                <p class="text-[11px] font-extrabold text-[#9F4813] leading-snug break-words w-full">
                  <%= safe_join((@trip.area.presence || @trip.title).to_s.split(/[[:space:]]+/), tag.br) %>
                </p>
                <svg class="w-4 h-4 text-[#B8642E] pt-0.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2c-4.42 0-8 .5-8 4v9.5C4 17.43 5.57 19 7.5 19L6 20.5v.5h2l2-2h4l2 2h2v-.5L16.5 19c1.93 0 3.5-1.57 3.5-3.5V6c0-3.5-3.58-4-8-4zM7.5 17c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm3.5-6H6V6h5v5zm2 0V6h5v5h-5zm3.5 6c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                </svg>
              </div>
            </div>
          </section>
        </div>
      </div>

      <!-- 3. タイムスケジュール -->
      <section class="relative rounded-2xl border-[1.5px] border-[#E6C7AE] bg-[#FFFDFB] pl-7 pr-4 py-5 shadow-[0_4px_14px_rgba(159,72,19,0.08)] overflow-hidden">
        <h2 class="mb-4 pb-2 border-b border-dashed border-[#E6C7AE] text-center text-[16px] font-extrabold text-[#3D2B1F] tracking-wide"
            style="font-family: 'Kaisei Decol', serif;">
          当日のタイムスケジュール 🐾
        </h2>

        <ol class="relative border-l-2 border-dashed border-[#E89B65] ml-3 space-y-6">
          <% @trip.schedules.each_with_index do |schedule, index| %>
            <li class="ml-5">
              <!-- 番号付きオレンジピン -->
              <span class="absolute -left-[13px] flex h-6 w-6 items-center justify-center rounded-full bg-[#E88B44] text-[11px] font-extrabold text-white ring-4 ring-[#FFFDFB] shadow-xs">
                <%= index + 1 %>
              </span>

              <div class="mb-1 flex flex-wrap items-center gap-1.5">
                <time class="text-sm font-extrabold text-[#B86B35]">
                  <%= schedule.start_time %>
                </time>
                <% if schedule.category.present? %>
                  <span class="rounded-md border border-[#F0D6C0] bg-[#FFF9F3] px-2 py-0.5 text-[11px] font-bold text-[#7A5236]">
                    <%= schedule.category %>
                  </span>
                <% end %>
                <% if schedule.estimated_cost.present? %>
                  <span class="rounded-md border border-[#F0C9AC] bg-[#FCEFE3]/70 px-2 py-0.5 text-[11px] font-bold text-[#9F4813]">
                    💰 <%= schedule.estimated_cost %>
                  </span>
                <% end %>
              </div>

              <h3 class="text-[15px] font-extrabold text-[#3D2B1F]">
                <%= schedule.place_name %>
              </h3>

              <% if schedule.content.present? %>
                <p class="mt-1 text-[12.5px] leading-relaxed text-[#5C4738]">
                  <%= schedule.content %>
                </p>
              <% end %>

              <!-- Googleマップで開くリンク -->
              <% map_query = CGI.escape([@trip.area, schedule.place_name].compact.join(" ")) %>
              <div class="mt-2">
                <%= link_to "https://www.google.com/maps/search/?api=1&query=#{map_query}",
                            target: "_blank",
                            rel: "noopener noreferrer",
                            class: "inline-flex items-center gap-1 rounded-full border border-[#E5B089] bg-[#FFF9F3] px-3 py-1 text-[11.5px] font-bold text-[#9F4813] hover:bg-[#FCEFE3] transition" do %>
                  <span>📍 Googleマップで見る</span>
                  <span class="text-[10px]">↗</span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ol>

        <p class="mt-5 border-t border-dashed border-[#E6C7AE] pt-3 text-[11px] leading-relaxed text-[#8C705B]">
          ※ 金額は1人あたりの目安です。全体の目安予算には、往復の交通費やその他の飲食・お土産代も含まれています。
        </p>
      </section>

      <!-- しおり編集機能（本リリースで実装予定） -->
      <div class="rounded-2xl border border-dashed border-[#E5B089] bg-[#FFF9F3] px-4 py-3.5 flex items-center justify-between gap-3">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[13px] font-extrabold text-[#5C4738]">✏️ しおりの編集</span>
            <span class="rounded-full bg-[#FCEFE3] border border-[#F0C9AC] px-2 py-0.5 text-[10px] font-extrabold text-[#9F4813]">
              🔒 ログイン限定（準備中）
            </span>
          </div>
          <p class="text-[11px] text-[#8C705B]">
            ログイン後、スケジュールやメモを自由に編集できるようになります。
          </p>
        </div>
      </div>

      <!-- 4. 持ち物チェックシート（本リリースで実装予定） -->
      <section class="rounded-2xl border-[1.5px] border-[#E6C7AE] bg-[#FFFDFB] px-5 py-5 shadow-[0_4px_14px_rgba(159,72,19,0.08)]">
        <h2 class="mb-4 pb-2 border-b border-dashed border-[#E6C7AE] text-center text-[16px] font-extrabold text-[#3D2B1F] tracking-wide"
            style="font-family: 'Kaisei Decol', serif;">
          持ち物チェックシート 🐾
        </h2>

        <div class="rounded-xl border border-dashed border-[#E6C7AE] bg-[#FFF9F3] px-4 py-6 text-center space-y-2">
          <span class="inline-block rounded-full bg-[#FCEFE3] border border-[#F0C9AC] px-3 py-0.5 text-[11px] font-extrabold text-[#9F4813]">
            🔒 ログイン限定（準備中）
          </span>
          <p class="text-[12.5px] font-bold text-[#5C4738] leading-relaxed">
            ログイン後に使える機能として準備中です。
          </p>
          <p class="text-[11px] text-[#8C705B] leading-relaxed">
            旅に必要な持ち物をリストアップして、<br>出発前にチェックできるようになります。
          </p>
        </div>
      </section>

      <!-- 5. 旅のしおりを共有する（URLワンクリックコピー） -->
      <section data-controller="clipboard"
               class="rounded-2xl border-[1.5px] border-[#E6C7AE] bg-[#FFFDFB] p-5 shadow-[0_4px_14px_rgba(159,72,19,0.08)] space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-[15px] font-extrabold text-[#3D2B1F] tracking-wide"
              style="font-family: 'Kaisei Decol', serif;">
            このしおりを共有する 🐾
          </h2>
          <span class="rounded-full bg-[#FCEFE3] border border-[#F0C9AC] px-2.5 py-0.5 text-[10.5px] font-extrabold text-[#9F4813]">
            URLを送るだけ！
          </span>
        </div>

        <input type="text"
               value="<%= trip_url(@trip) %>"
               readonly
               data-clipboard-target="source"
               class="w-full rounded-xl border border-[#E6C7AE] bg-[#FAF6F0] px-3 py-2 text-xs text-[#5C4738] focus:outline-none">

        <button type="button"
                data-action="click->clipboard#copy"
                class="flex justify-center items-center gap-2 w-full h-[52px] rounded-full bg-gradient-to-b from-[#EEA065] to-[#DF7D3E] text-white text-[15px] font-extrabold shadow-[0_4px_10px_rgba(215,115,55,0.3)] hover:opacity-95 active:translate-y-0.5 transition-all cursor-pointer">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span data-clipboard-target="buttonLabel">共有URLをコピーする</span>
        </button>
      </section>

      <!-- 6. アクションボタン -->
      <div class="space-y-3 pt-1">
        <%= link_to "新しく旅を計画する",
                    new_trip_path,
                    class: "flex justify-center items-center w-full h-[50px] rounded-full bg-[#FFFDFB] text-[#5A3E2B] text-sm font-extrabold border-[1.5px] border-[#E5B089] shadow-[0_2px_6px_rgba(159,72,19,0.06)] hover:bg-[#FFF9F4] active:translate-y-0.5 transition-all" %>

        <%= link_to "トップページに戻る",
                    root_path,
                    class: "flex justify-center items-center w-full h-[48px] rounded-full bg-transparent text-[#7A5C43] text-xs font-extrabold underline underline-offset-4 decoration-[#7A5C43]/50 hover:opacity-75 transition-opacity" %>
      </div>
    </div>

  </div>
</div>