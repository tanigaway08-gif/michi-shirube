<%# app/views/shared/_header.html.erb %>
<header class="relative -mx-5 px-4 h-14 bg-[#E58A53] flex items-center justify-between text-white shadow-xs z-30">
  <!-- 左端：前画面へ戻るリンク（back_path が渡されなければ root_path に戻る） -->
  <%= link_to (local_assigns[:back_path] || root_path), class: "flex items-center gap-0.5 text-white hover:opacity-80 active:-translate-x-0.5 transition-all py-1.5 pr-2 z-10" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    <span class="text-[14px] font-bold tracking-wider">戻る</span>
  <% end %>

  <!-- 中央：ロゴアイコン ＋ 未知しるべタイトル（クリックでトップへ遷移） -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <%= link_to root_path, class: "pointer-events-auto flex items-center gap-1.5 py-1 px-2 hover:opacity-85 active:scale-95 active:opacity-75 select-none transition-all duration-100" do %>
      <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2c-4.42 0-8 .5-8 4v9.5C4 17.43 5.57 19 7.5 19L6 20.5v.5h2l2-2h4l2 2h2v-.5L16.5 19c1.93 0 3.5-1.57 3.5-3.5V6c0-3.5-3.58-4-8-4zM7.5 17c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm3.5-6H6V6h5v5zm2 0V6h5v5h-5zm3.5 6c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
      </svg>
      <span class="text-[20px] font-bold tracking-[0.12em]" style="font-family: 'Kaisei Decol', serif;">
        未知しるべ
      </span>
    <% end %>
  </div>

  <!-- 右端：バランス用スペーサー -->
  <div class="w-12"></div>
</header>